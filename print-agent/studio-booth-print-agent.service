[Unit]
Description=Studio Booth Print Agent
After=network.target cups.service
Wants=cups.service

[Service]
Type=simple
# Adjust these two paths if you install somewhere other than the default
# location used by install.sh, or run as a user other than "pi".
ExecStart=/usr/bin/node /home/pi/studio-booth-print-agent/server.js
WorkingDirectory=/home/pi/studio-booth-print-agent
Restart=always
RestartSec=2
User=pi
Environment=PORT=8787

[Install]
WantedBy=multi-user.target
